# Django configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Public site URL (used for badge QR links when no request is available)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Brevo transactional email — badge delivery
# Create an API key under Brevo → SMTP & API, and verify the sender address.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=@iLabAfrica Centre

# Database configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=events_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Postgres container specific configuration
POSTGRES_DB=events_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
